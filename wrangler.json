{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turkey-vulture-software",
  "account_id": "b1aa310aa0a1638d72b8b086a21e557c",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "hmarquardt@gmail.com",
      "allowed_sender_addresses": ["contact@turkeyvulturesoftware.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "4302",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "turkeyvulturesoftware.com",
      "zone_id": "5b51c5134d58c24ed465a80afa21cfde",
      "custom_domain": true
    },
    {
      "pattern": "www.turkeyvulturesoftware.com",
      "zone_id": "5b51c5134d58c24ed465a80afa21cfde",
      "custom_domain": true
    }
  ]
}
